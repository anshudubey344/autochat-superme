# Port and address the dashboard listens on.
# Behind nginx (recommended): HOST=127.0.0.1 and TRUST_PROXY=1
PORT=3000
HOST=0.0.0.0
# TRUST_PROXY=1

# Set to true when the dashboard is served over HTTPS (nginx + certbot). Makes the sign-in cookie HTTPS-only.
COOKIE_SECURE=false

# Sign-in sessions: maximum length (hours) and sign-out after inactivity (minutes)
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120

# Time zone for sending hours and daily limits
TZ=Asia/Kolkata

# Default for how often sheets are checked for new rows (seconds); admins can change it in the dashboard
POLL_SECONDS=15

# "Connect Google account" (open any sheet without sharing it). Free; see README → Connect Google account.
# PUBLIC_URL is the https address you open the dashboard on (no trailing slash).
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Google service account key (reads PRIVATE sheets and writes status back)
GOOGLE_KEY_FILE=./google-key.json

# Optional: use an installed Chrome/Chromium instead of the bundled one
# CHROME_PATH=/usr/bin/chromium-browser

# The admin account is created with:  npm run setup-admin

# Branding: name shown in the header and browser tab, and the main colour.
# Leave BRAND_COLOR empty to take the colour from the logo automatically.
# Logo and tab icon: put the URLs here and run  npm run fetch-brand
BRAND_NAME=SuperMe
BRAND_COLOR=
BRAND_LOGO_URL=https://www.mysuperme.com/logo-1.png
BRAND_ICON_URL=https://www.mysuperme.com/symbol.png
